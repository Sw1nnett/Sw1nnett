# Trading Bot Configuration Template
# Copy to .env and fill in real values. NEVER commit .env to version control.

# ============================================================
# RUNTIME
# ============================================================
ENV=development
TRADING_MODE=paper          # Options: backtest, paper, live_dry_run, live_guarded
LOG_LEVEL=INFO
LOG_DIR=logs

# ============================================================
# LIVE TRADING GATES (all three required for live_guarded mode)
# ============================================================
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION_TOKEN=

# ============================================================
# BROKER
# ============================================================
BROKER=simulator            # Options: simulator, alpaca, ibkr

# Alpaca credentials (paper trading)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ============================================================
# DATA STORES
# ============================================================
DATABASE_URL=postgresql+asyncpg://trader:trader@localhost:5432/tradingbot
REDIS_URL=redis://localhost:6379/0

# ============================================================
# API
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-before-production
API_ALLOWED_IPS=127.0.0.1,::1
API_ADMIN_PASSWORD=change-me

# ============================================================
# SYMBOL UNIVERSE
# ============================================================
SYMBOL_ALLOWLIST=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMD,TSLA,META

# ============================================================
# RISK PARAMETERS
# ============================================================
MAX_DAILY_LOSS_PCT=0.02         # 2% of account equity
MAX_DAILY_DRAWDOWN_PCT=0.03     # 3% intraday drawdown
MAX_POSITION_SIZE_PCT=0.10      # 10% per position
MAX_OPEN_POSITIONS=5
MAX_GROSS_EXPOSURE_PCT=0.90
MAX_NET_EXPOSURE_PCT=0.50
RISK_PER_TRADE_PCT=0.005        # 0.5% risk per trade
SPREAD_LIMIT_BPS=30             # Max acceptable spread
STALE_DATA_SECONDS=60
WASH_COOLDOWN_SECONDS=300
FLIP_COOLDOWN_SECONDS=120
SESSION_CUTOFF_MINUTES=15       # Stop new orders 15 min before close

# ============================================================
# METRICS
# ============================================================
METRICS_PORT=9090
