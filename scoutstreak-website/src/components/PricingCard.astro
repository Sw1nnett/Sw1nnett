---
interface Props {
  tier: string;
  price: string;
  features: string[];
}
const { tier, price, features } = Astro.props;
---

<div class="bg-bg-secondary border border-border rounded-xl p-6 flex flex-col">
  <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-text-muted">{tier}</p>
  <p class="font-display text-[36px] text-gold leading-none mt-3">
    {price}<span class="text-text-muted text-base font-body font-400">/mo</span>
  </p>
  <ul class="mt-6 space-y-3 flex-1">
    {features.map((f) => (
      <li class="text-text-muted text-sm flex items-start gap-2">
        <span class="text-gold-dim mt-0.5 shrink-0">&rarr;</span>
        <span>{f}</span>
      </li>
    ))}
  </ul>
  <p class="font-mono text-[9px] uppercase tracking-[0.15em] text-text-muted mt-6 pt-4 border-t border-border">
    Available at launch
  </p>
</div>
