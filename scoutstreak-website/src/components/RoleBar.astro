---
interface Props {
  emoji: string;
  role: string;
  headline: string;
  features: string[];
  price: string;
  borderColor: string;
}
const { emoji, role, headline, features, price, borderColor } = Astro.props;
---

<div class={`border-l-[3px] bg-bg-secondary rounded-r-xl p-6 md:p-8 flex flex-col md:flex-row md:items-start gap-4 md:gap-8`} style={`border-left-color: ${borderColor};`}>
  <div class="flex items-start gap-4 flex-1">
    <span class="text-[28px] shrink-0" aria-hidden="true">{emoji}</span>
    <div class="flex-1">
      <p class="font-body font-600 text-text text-base">
        <span class="text-text-muted font-mono text-[10px] uppercase tracking-[0.12em] mr-2">{role}</span>
        {headline}
      </p>
      <ul class="mt-3 space-y-1.5">
        {features.map((f) => (
          <li class="text-text-muted text-sm flex items-start gap-2">
            <span class="text-gold-dim mt-0.5 shrink-0">&rarr;</span>
            <span>{f}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-text-muted border border-border rounded-full px-3 py-1.5 shrink-0 self-start md:self-center">
    {price}
  </span>
</div>
