---
interface Props {
  emoji: string;
  title: string;
  description: string;
}
const { emoji, title, description } = Astro.props;
---

<div class="bg-bg-secondary border border-border rounded-xl p-5 flex flex-col gap-3">
  <span class="text-xl" aria-hidden="true">{emoji}</span>
  <h3 class="font-body font-600 text-text text-sm">{title}</h3>
  <p class="text-text-muted text-[13px] leading-relaxed">{description}</p>
</div>
